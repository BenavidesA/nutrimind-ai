<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutriMind.Mobile.Views.Auth.ForgotPasswordPage"
             BackgroundColor="{StaticResource SystemBackground}"
             Shell.NavBarIsVisible="False"
             Title="Recuperar contraseña">

    <ScrollView>
        <VerticalStackLayout Padding="30,80,30,30" Spacing="25">

            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                <Image Source="logo.png" WidthRequest="70" HeightRequest="60" HorizontalOptions="Center"/>
                <Label Text="Recuperar contraseña" FontFamily="OpenSansSemibold" FontSize="24" TextColor="{StaticResource PrimaryText}" HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <Border StrokeShape="RoundRectangle 16" Stroke="Transparent" BackgroundColor="{StaticResource CardBackground}" Padding="20">
                <VerticalStackLayout Spacing="15">

                    <!-- Paso 1: correo -->
                    <VerticalStackLayout Spacing="15" IsVisible="False">
                        <VerticalStackLayout.Triggers>
                            <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding CurrentStep}" Value="1">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </VerticalStackLayout.Triggers>

                        <Label Text="Ingresa tu correo electrónico y te enviaremos un código de verificación." FontSize="14" TextColor="{StaticResource SecondaryText}"/>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Correo electrónico" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource SecondaryText}"/>
                            <Border StrokeThickness="0" BackgroundColor="#F2F2F7" StrokeShape="RoundRectangle 10" Padding="15,0" HeightRequest="50">
                                <Entry Text="{Binding Email}" Keyboard="Email" Placeholder="correo@ejemplo.com" TextColor="Black" BackgroundColor="Transparent"/>
                            </Border>
                        </VerticalStackLayout>

                        <Button Text="Enviar código" Command="{Binding SendCodeCommand}" BackgroundColor="{StaticResource AppleGreen}" TextColor="White" FontAttributes="Bold" FontSize="16" CornerRadius="12" HeightRequest="55" HorizontalOptions="Fill"/>
                    </VerticalStackLayout>

                    <!-- Paso 2: código -->
                    <VerticalStackLayout Spacing="15" IsVisible="False">
                        <VerticalStackLayout.Triggers>
                            <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding CurrentStep}" Value="2">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </VerticalStackLayout.Triggers>

                        <Label Text="Ingresa el código de 6 dígitos que enviamos a tu correo." FontSize="14" TextColor="{StaticResource SecondaryText}"/>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Código" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource SecondaryText}"/>
                            <Border StrokeThickness="0" BackgroundColor="#F2F2F7" StrokeShape="RoundRectangle 10" Padding="15,0" HeightRequest="50">
                                <Entry Text="{Binding Code}" Keyboard="Numeric" Placeholder="123456" TextColor="Black" BackgroundColor="Transparent" MaxLength="6"/>
                            </Border>
                        </VerticalStackLayout>

                        <Button Text="Verificar código" Command="{Binding VerifyCodeCommand}" BackgroundColor="{StaticResource AppleGreen}" TextColor="White" FontAttributes="Bold" FontSize="16" CornerRadius="12" HeightRequest="55" HorizontalOptions="Fill"/>
                    </VerticalStackLayout>

                    <!-- Paso 3: nueva contraseña -->
                    <VerticalStackLayout Spacing="15" IsVisible="False">
                        <VerticalStackLayout.Triggers>
                            <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding CurrentStep}" Value="3">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </VerticalStackLayout.Triggers>

                        <Label Text="Ingresa tu nueva contraseña." FontSize="14" TextColor="{StaticResource SecondaryText}"/>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Nueva contraseña" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource SecondaryText}"/>
                            <Border StrokeThickness="0" BackgroundColor="#F2F2F7" StrokeShape="RoundRectangle 10" Padding="15,0" HeightRequest="50">
                                <Entry Text="{Binding NewPassword}" IsPassword="True" Placeholder="••••••••" TextColor="Black" BackgroundColor="Transparent"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Confirmar contraseña" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource SecondaryText}"/>
                            <Border StrokeThickness="0" BackgroundColor="#F2F2F7" StrokeShape="RoundRectangle 10" Padding="15,0" HeightRequest="50">
                                <Entry Text="{Binding ConfirmPassword}" IsPassword="True" Placeholder="••••••••" TextColor="Black" BackgroundColor="Transparent"/>
                            </Border>
                        </VerticalStackLayout>

                        <Button Text="Cambiar contraseña" Command="{Binding ResetPasswordCommand}" BackgroundColor="{StaticResource AppleGreen}" TextColor="White" FontAttributes="Bold" FontSize="16" CornerRadius="12" HeightRequest="55" HorizontalOptions="Fill"/>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <Button Text="Cancelar" Command="{Binding CancelCommand}" BackgroundColor="Transparent" TextColor="{StaticResource SecondaryText}" FontAttributes="Bold" FontSize="15" HorizontalOptions="Fill"/>

            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource AppleGreen}" HorizontalOptions="Center"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
