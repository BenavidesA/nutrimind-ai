<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="NutriMind.Mobile.Views.Auth.LoginPage"
    BackgroundColor="{StaticResource SystemBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="30,80,30,30" Spacing="40">

            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                <Image Source="logo.png" WidthRequest="90" HeightRequest="80" HorizontalOptions="Center"/>
                <Label Text="NutriMind"
                       FontFamily="OpenSansSemibold"
                       FontSize="30"
                       CharacterSpacing="0.5"
                       TextColor="{StaticResource PrimaryText}"
                       HorizontalOptions="Center"/>
                <Label Text="Tu IA personal de nutrición"
                       FontSize="16"
                       TextColor="{StaticResource SecondaryText}"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <Border StrokeShape="RoundRectangle 16"
                    Stroke="Transparent"
                    BackgroundColor="{StaticResource CardBackground}"
                    Margin="0,20,0,0">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,6" Radius="24" Opacity="0.06"/>
                </Border.Shadow>

                <VerticalStackLayout>
                    <Grid ColumnDefinitions="40, *">
                        <Label Text="&#xe0be;" FontFamily="MaterialOutlined" FontSize="20" TextColor="{StaticResource SecondaryText}" Grid.Column="0" VerticalOptions="Center" HorizontalOptions="Center" Margin="15,0,0,0"/>
                        <Entry Grid.Column="1"
                               Text="{Binding Email}"
                               Placeholder="correo@ejemplo.com"
                               Keyboard="Email"
                               IsReadOnly="{Binding IsBusy}"
                               ClearButtonVisibility="WhileEditing"
                               BackgroundColor="Transparent"
                               TextColor="{StaticResource PrimaryText}"
                               HeightRequest="60"
                               Margin="10,0"/>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource SeparatorColor}" Margin="20,0,0,0"/>

                    <Grid ColumnDefinitions="40, *, 50">
                        <Label Text="&#xe88d;" FontFamily="MaterialOutlined" FontSize="20" TextColor="{StaticResource SecondaryText}" Grid.Column="0" VerticalOptions="Center" HorizontalOptions="Center" Margin="15,0,0,0"/>
                        <Entry Grid.Column="1"
                               Text="{Binding Password}"
                               Placeholder="Contraseña"
                               IsPassword="{Binding IsPasswordPassword}"
                               IsReadOnly="{Binding IsBusy}"
                               BackgroundColor="Transparent"
                               TextColor="{StaticResource PrimaryText}"
                               HeightRequest="60"
                               Margin="10,0"/>

                        <ImageButton Grid.Column="2" 
                                     Command="{Binding TogglePasswordVisibilityCommand}"
                                     BackgroundColor="Transparent"
                                     WidthRequest="24" HeightRequest="24">
                            <ImageButton.Source>
                                <FontImageSource FontFamily="MaterialOutlined" Glyph="&#xe417;" Color="{StaticResource SecondaryText}" Size="20"/>
                            </ImageButton.Source>
                        </ImageButton>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding ErrorMessage}" 
                   TextColor="{StaticResource DestructiveRed}"
                   HorizontalOptions="Center">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding ErrorMessage.Length}" Value="0">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

            <Grid>
                <Button Text="Iniciar sesión"
                        Command="{Binding LoginCommand}"
                        BackgroundColor="{StaticResource AppleGreen}"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="18"
                        CornerRadius="16"
                        HeightRequest="60">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <ActivityIndicator IsRunning="{Binding IsBusy}" 
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource AppleGreen}"
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center"/>
            </Grid>

            <Button Text="¿Olvidaste tu contraseña?"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource SecondaryText}"
                    Command="{Binding GoToForgotPasswordCommand}"
                    FontSize="14"
                    Margin="0,10,0,0"/>

            <Button Text="¿No tienes cuenta? Regístrate aquí"
                    BackgroundColor="Transparent"
                    TextColor="#5E5CE6"
                    Command="{Binding GoToRegisterCommand}"
                    FontSize="14"
                    FontAttributes="Bold"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>