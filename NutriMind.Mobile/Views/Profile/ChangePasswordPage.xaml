<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutriMind.Mobile.Views.Profile.ChangePasswordPage"
             BackgroundColor="{StaticResource SystemBackground}"
             Title="Cambiar Contraseña">

    <ScrollView>
        <VerticalStackLayout Padding="20,30,20,20" Spacing="25">

            <Label Text="Cambiar contraseña" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource PrimaryText}"/>

            <Border StrokeShape="RoundRectangle 12" Stroke="Transparent" BackgroundColor="{StaticResource CardBackground}" Padding="20">
                <VerticalStackLayout Spacing="15">

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Contraseña actual" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource SecondaryText}"/>
                        <Border StrokeThickness="0" BackgroundColor="#F2F2F7" StrokeShape="RoundRectangle 10" Padding="15,0" HeightRequest="50">
                            <Entry Text="{Binding CurrentPassword}" IsPassword="True" Placeholder="••••••••" TextColor="Black" BackgroundColor="Transparent"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Nueva contraseña" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource SecondaryText}"/>
                        <Border StrokeThickness="0" BackgroundColor="#F2F2F7" StrokeShape="RoundRectangle 10" Padding="15,0" HeightRequest="50">
                            <Entry Text="{Binding NewPassword}" IsPassword="True" Placeholder="••••••••" TextColor="Black" BackgroundColor="Transparent"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Confirmar nueva contraseña" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource SecondaryText}"/>
                        <Border StrokeThickness="0" BackgroundColor="#F2F2F7" StrokeShape="RoundRectangle 10" Padding="15,0" HeightRequest="50">
                            <Entry Text="{Binding ConfirmPassword}" IsPassword="True" Placeholder="••••••••" TextColor="Black" BackgroundColor="Transparent"/>
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <Button Text="Guardar" Command="{Binding SaveCommand}" BackgroundColor="{StaticResource AppleGreen}" TextColor="White" FontAttributes="Bold" FontSize="16" CornerRadius="12" HeightRequest="55" HorizontalOptions="Fill" Margin="0,10,0,0"/>
            <Button Text="Cancelar" Command="{Binding CancelCommand}" BackgroundColor="Transparent" TextColor="{StaticResource SecondaryText}" FontAttributes="Bold" FontSize="16" HorizontalOptions="Fill"/>

            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource AppleGreen}" HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
