<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutriMind.Mobile.Views.Profile.ProfilePage"
             BackgroundColor="{StaticResource SystemBackground}"
             Title="Perfil">

    <ScrollView>
        <VerticalStackLayout Padding="20,30,20,20" Spacing="25">

            <Label Text="Mi Perfil" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource PrimaryText}"/>
            <Label Text="{Binding Email}" FontSize="15" TextColor="{StaticResource SecondaryText}" Margin="0,-15,0,0"/>

            <Border StrokeShape="RoundRectangle 12" Stroke="Transparent" BackgroundColor="{StaticResource CardBackground}" Padding="20">
                <VerticalStackLayout Spacing="15">

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Nombre" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource SecondaryText}"/>
                        <Border StrokeThickness="0" BackgroundColor="#F2F2F7" StrokeShape="RoundRectangle 10" Padding="15,0" HeightRequest="50">
                            <Entry Text="{Binding FirstName}" Placeholder="Nombre" TextColor="Black" BackgroundColor="Transparent"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Apellido" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource SecondaryText}"/>
                        <Border StrokeThickness="0" BackgroundColor="#F2F2F7" StrokeShape="RoundRectangle 10" Padding="15,0" HeightRequest="50">
                            <Entry Text="{Binding LastName}" Placeholder="Apellido" TextColor="Black" BackgroundColor="Transparent"/>
                        </Border>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="{StaticResource SeparatorColor}" Margin="0,5"/>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Edad" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource SecondaryText}"/>
                        <Border StrokeThickness="0" BackgroundColor="#F2F2F7" StrokeShape="RoundRectangle 10" Padding="15,0" HeightRequest="50">
                            <Entry Text="{Binding Age}" Keyboard="Numeric" Placeholder="Ej. 22" TextColor="Black" BackgroundColor="Transparent"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Género" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource SecondaryText}"/>
                        <Border StrokeThickness="0" BackgroundColor="#F2F2F7" StrokeShape="RoundRectangle 10" Padding="15,0" HeightRequest="50">
                            <Entry Text="{Binding Gender}" Placeholder="Ej. Femenino, Masculino" TextColor="Black" BackgroundColor="Transparent"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Altura (cm)" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource SecondaryText}"/>
                        <Border StrokeThickness="0" BackgroundColor="#F2F2F7" StrokeShape="RoundRectangle 10" Padding="15,0" HeightRequest="50">
                            <Entry Text="{Binding HeightCm}" Keyboard="Numeric" Placeholder="Ej. 170" TextColor="Black" BackgroundColor="Transparent"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Peso (kg)" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource SecondaryText}"/>
                        <Border StrokeThickness="0" BackgroundColor="#F2F2F7" StrokeShape="RoundRectangle 10" Padding="15,0" HeightRequest="50">
                            <Entry Text="{Binding WeightKg}" Keyboard="Numeric" Placeholder="Ej. 65" TextColor="Black" BackgroundColor="Transparent"/>
                        </Border>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="{StaticResource SeparatorColor}" Margin="0,5"/>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Nivel de actividad" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource SecondaryText}"/>
                        <Border StrokeThickness="0" BackgroundColor="#F2F2F7" StrokeShape="RoundRectangle 10" Padding="15,0" HeightRequest="50">
                            <Grid ColumnDefinitions="*, Auto">
                                <Picker Grid.Column="0" ItemsSource="{Binding ActivityLevels}" SelectedItem="{Binding ActivityLevelDisplay}" TextColor="Black" BackgroundColor="Transparent"/>
                                <Label Grid.Column="1" Text="&#xe5cf;" FontFamily="MaterialOutlined" FontSize="20" TextColor="{StaticResource SecondaryText}" VerticalOptions="Center" InputTransparent="True"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Objetivo" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource SecondaryText}"/>
                        <Border StrokeThickness="0" BackgroundColor="#F2F2F7" StrokeShape="RoundRectangle 10" Padding="15,0" HeightRequest="50">
                            <Grid ColumnDefinitions="*, Auto">
                                <Picker Grid.Column="0" ItemsSource="{Binding DietaryGoals}" SelectedItem="{Binding DietaryGoalDisplay}" TextColor="Black" BackgroundColor="Transparent"/>
                                <Label Grid.Column="1" Text="&#xe5cf;" FontFamily="MaterialOutlined" FontSize="20" TextColor="{StaticResource SecondaryText}" VerticalOptions="Center" InputTransparent="True"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="{StaticResource SeparatorColor}" Margin="0,5"/>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Universidad" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource SecondaryText}"/>
                        <Border StrokeThickness="0" BackgroundColor="#F2F2F7" StrokeShape="RoundRectangle 10" Padding="15,0" HeightRequest="50">
                            <Entry Text="{Binding University}" Placeholder="Ej. UDLA" TextColor="Black" BackgroundColor="Transparent"/>
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <Button Text="Guardar Cambios" Command="{Binding SaveCommand}" BackgroundColor="{StaticResource AppleGreen}" TextColor="White" FontAttributes="Bold" FontSize="16" CornerRadius="12" HeightRequest="55" Margin="0,10,0,0"/>

            <Label Text="Medallas" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource SecondaryText}" Margin="0,10,0,0"/>
            <Border StrokeShape="RoundRectangle 12" Stroke="Transparent" BackgroundColor="{StaticResource CardBackground}" Padding="20">
                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Badges}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Label Text="{Binding Name}" FontSize="16" TextColor="{StaticResource PrimaryText}"/>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                    <BindableLayout.EmptyView>
                        <Label Text="Todavía no has ganado medallas." FontSize="14" TextColor="{StaticResource SecondaryText}"/>
                    </BindableLayout.EmptyView>
                </VerticalStackLayout>
            </Border>

            <Border StrokeShape="RoundRectangle 12" Stroke="Transparent" BackgroundColor="{StaticResource CardBackground}" Margin="0,10,0,0">
                <VerticalStackLayout>
                    <Grid Padding="20,16" HeightRequest="55">
                        <Label Text="Cambiar Contraseña" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource PrimaryText}" VerticalOptions="Center"/>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToChangePasswordCommand}"/>
                        </Grid.GestureRecognizers>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource SeparatorColor}" Margin="20,0,0,0"/>

                    <Grid Padding="20,16" HeightRequest="55">
                        <Label Text="Cerrar Sesión" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource PrimaryText}" VerticalOptions="Center"/>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding LogoutCommand}"/>
                        </Grid.GestureRecognizers>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource SeparatorColor}" Margin="20,0,0,0"/>

                    <Grid Padding="20,16" HeightRequest="55">
                        <Label Text="Eliminar Cuenta" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource DestructiveRed}" VerticalOptions="Center"/>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding DeleteAccountCommand}"/>
                        </Grid.GestureRecognizers>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource AppleGreen}" HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
