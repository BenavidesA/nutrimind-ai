<?xml version="1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:NutriMind.Mobile"
             x:Class="NutriMind.Mobile.App">

    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="SystemBackground">#F2F2F7</Color>
            <Color x:Key="CardBackground">#FFFFFF</Color>
            <Color x:Key="PrimaryText">#000000</Color>
            <Color x:Key="SecondaryText">#8E8E93</Color>
            <Color x:Key="AppleGreen">#34C759</Color>
            <Color x:Key="DestructiveRed">#FF3B30</Color>
            <Color x:Key="SeparatorColor">#C6C6C8</Color>

            <!-- Agregados para resolver XamlParseException en AIAssistantPage -->
            <Color x:Key="BgSecondary">#F2F2F7</Color>
            <Color x:Key="BgSecondaryDark">#1C1C1E</Color>
            <Color x:Key="BgCard">#FFFFFF</Color>
            <Color x:Key="BgCardDark">#2C2C2E</Color>
            <Color x:Key="TextPrimary">#000000</Color>
            <Color x:Key="TextSecondary">#8E8E93</Color>
            <Color x:Key="TextTertiary">#C7C7CC</Color>
            <Color x:Key="PrimaryBlue">#5E5CE6</Color>
            <Color x:Key="Separator">#C6C6C8</Color>

            <!-- Agregados para resolver XamlParseException en HistoryPage -->
            <Color x:Key="ColorProtein">#AF52DE</Color>
            <Color x:Key="ColorCarbs">#FF9500</Color>
            <Color x:Key="ColorFat">#FF3B30</Color>
        </ResourceDictionary>
    </Application.Resources>

</Application>