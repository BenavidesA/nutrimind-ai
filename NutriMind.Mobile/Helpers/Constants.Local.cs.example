namespace NutriMind.Mobile.Helpers;

// Copy this file to "Constants.Local.cs" (gitignored) to test on a physical Android device.
// Set LocalDevHost to your dev machine's LAN IPv4 address (run "ipconfig" and check the Wi-Fi
// adapter) — the phone and the dev machine must be on the same Wi-Fi network. If you're using
// the Android emulator instead, set it to "10.0.2.2".
//
// Also add this IP as a <domain> entry in
// NutriMind.Mobile/Platforms/Android/Resources/xml/network_security_config.xml so Android
// allows plain HTTP traffic to it.
public static partial class Constants
{
    public const string LocalDevHost = "192.168.1.100";
}
