<?xml version="1.0" encoding="utf-8"?>
<!--
  Android bloquea tráfico HTTP (cleartext) por defecto desde API 28. La API local corre en
  Docker por HTTP (puerto 8080, sin certificado), así que se permite cleartext únicamente
  hacia los hosts usados en desarrollo: 10.0.2.2 (alias del emulador hacia el localhost del
  host) y la IP LAN de la PC (para probar desde un teléfono físico en la misma red Wi-Fi,
  ver Constants.BaseUrl) — el resto del tráfico de la app sigue exigiendo HTTPS.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.100.115</domain>
    </domain-config>
</network-security-config>
