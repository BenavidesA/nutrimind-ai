@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Cambiar contraseña";
}

<div class="page-header">
    <h1>Cambiar contraseña</h1>
</div>

<div class="card" style="max-width: 420px;">
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-error">@Model.ErrorMessage</div>
    }

    <form asp-action="ChangePassword" method="post" data-validate novalidate>
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label class="form-label" asp-for="CurrentPassword"></label>
            <input asp-for="CurrentPassword" class="form-input" type="password" required autocomplete="current-password" />
            <span asp-validation-for="CurrentPassword" class="field-validation-error"></span>
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="NewPassword"></label>
            <input asp-for="NewPassword" class="form-input" type="password" required minlength="6" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="field-validation-error"></span>
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="ConfirmNewPassword"></label>
            <input asp-for="ConfirmNewPassword" class="form-input" type="password" required autocomplete="new-password" />
            <span asp-validation-for="ConfirmNewPassword" class="field-validation-error"></span>
        </div>

        <button type="submit" class="btn btn-primary mt-2">Cambiar contraseña</button>
    </form>

    <div class="text-center mt-3">
        <a class="btn-link" asp-action="Index">Volver al perfil</a>
    </div>
</div>
