@model EditProfileViewModel
@{
    ViewData["Title"] = "Editar perfil";
}

<div class="page-header">
    <h1>Editar perfil</h1>
</div>

<div class="card" style="max-width: 480px;">
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-error">@Model.ErrorMessage</div>
    }

    <form asp-action="Edit" method="post" data-validate novalidate>
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label class="form-label" asp-for="FirstName"></label>
            <input asp-for="FirstName" class="form-input" required />
            <span asp-validation-for="FirstName" class="field-validation-error"></span>
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="LastName"></label>
            <input asp-for="LastName" class="form-input" required />
            <span asp-validation-for="LastName" class="field-validation-error"></span>
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="Age"></label>
            <input asp-for="Age" class="form-input" type="number" min="1" max="120" />
            <span asp-validation-for="Age" class="field-validation-error"></span>
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="Gender"></label>
            <input asp-for="Gender" class="form-input" placeholder="Ej. Femenino, Masculino" />
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="HeightCm"></label>
            <input asp-for="HeightCm" class="form-input" type="number" step="0.1" min="50" max="260" />
            <span asp-validation-for="HeightCm" class="field-validation-error"></span>
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="WeightKg"></label>
            <input asp-for="WeightKg" class="form-input" type="number" step="0.1" min="1" max="400" />
            <span asp-validation-for="WeightKg" class="field-validation-error"></span>
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="ActivityLevel"></label>
            <select asp-for="ActivityLevel" class="form-input" asp-items="Html.GetEnumSelectList<ActivityLevel>()"></select>
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="DietaryGoal"></label>
            <select asp-for="DietaryGoal" class="form-input" asp-items="Html.GetEnumSelectList<DietaryGoal>()"></select>
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="University"></label>
            <input asp-for="University" class="form-input" />
        </div>

        <button type="submit" class="btn btn-primary mt-2">Guardar cambios</button>
    </form>

    <div class="text-center mt-3">
        <a class="btn-link" asp-action="Index">Cancelar</a>
    </div>
</div>
