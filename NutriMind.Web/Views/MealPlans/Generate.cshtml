@model GenerateMealPlanViewModel
@{
    ViewData["Title"] = "Generar plan con IA";
}

<div class="page-header">
    <h1>Generar plan con IA</h1>
</div>

<div class="card" style="max-width: 480px;">
    <p>Gemini genera un plan usando el catálogo real de alimentos y lo guarda automáticamente.</p>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-error">@Model.ErrorMessage</div>
    }

    <form asp-action="Generate" method="post" data-validate novalidate>
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label class="form-label" asp-for="TargetCalories"></label>
            <input asp-for="TargetCalories" class="form-input" type="number" step="1" min="1" placeholder="2000" required autofocus />
            <span asp-validation-for="TargetCalories" class="field-validation-error"></span>
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="Days"></label>
            <input asp-for="Days" class="form-input" type="number" step="1" min="1" max="30" required />
            <span asp-validation-for="Days" class="field-validation-error"></span>
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="DietType"></label>
            <input asp-for="DietType" class="form-input" placeholder="Ej. Vegetariana, Cualquiera" />
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="AllergiesText"></label>
            <input asp-for="AllergiesText" class="form-input" placeholder="Ej. Maní, Lácteos" />
        </div>

        <button type="submit" class="btn btn-primary mt-2">Generar plan</button>
    </form>

    <div class="text-center mt-3">
        <a class="btn-link" asp-action="Index">Cancelar</a>
    </div>
</div>
