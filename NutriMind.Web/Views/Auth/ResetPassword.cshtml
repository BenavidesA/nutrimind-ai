@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Nueva contraseña";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-header">
            <img src="~/images/logo.png" alt="NutriMind" />
            <h1>Nueva contraseña</h1>
            <p>Ingresa tu nueva contraseña.</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-error">@Model.ErrorMessage</div>
        }

        <form asp-controller="Auth" asp-action="ResetPassword" method="post" data-validate novalidate>
            @Html.AntiForgeryToken()
            <input asp-for="Email" type="hidden" />
            <input asp-for="Code" type="hidden" />

            <div class="form-group">
                <label class="form-label" asp-for="NewPassword"></label>
                <input asp-for="NewPassword" class="form-input" type="password" placeholder="••••••••" required minlength="6" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" class="form-input" type="password" placeholder="••••••••" required autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
            </div>

            <button type="submit" class="btn btn-primary mt-2">Cambiar contraseña</button>
        </form>
    </div>
</div>
