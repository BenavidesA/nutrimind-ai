@model RegisterViewModel
@{
    ViewData["Title"] = "Crear cuenta";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-header">
            <img src="~/images/logo.png" alt="NutriMind" />
            <h1>Crear cuenta</h1>
            <p>Regístrate para empezar a monitorear tu salud con IA.</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-error">@Model.ErrorMessage</div>
        }

        <form asp-controller="Auth" asp-action="Register" method="post" data-validate novalidate>
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label class="form-label" asp-for="FirstName"></label>
                <input asp-for="FirstName" class="form-input" placeholder="Nombre" required autocomplete="given-name" />
                <span asp-validation-for="FirstName" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="LastName"></label>
                <input asp-for="LastName" class="form-input" placeholder="Apellido" required autocomplete="family-name" />
                <span asp-validation-for="LastName" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="Email"></label>
                <input asp-for="Email" class="form-input" type="email" placeholder="correo@ejemplo.com" required autocomplete="email" />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="Password"></label>
                <input asp-for="Password" class="form-input" type="password" placeholder="••••••••" required minlength="6" autocomplete="new-password" />
                <span asp-validation-for="Password" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" class="form-input" type="password" placeholder="••••••••" required autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
            </div>

            <button type="submit" class="btn btn-primary mt-2">Registrarse</button>
        </form>

        <div class="auth-footer">
            ¿Ya tienes una cuenta? <a asp-controller="Auth" asp-action="Login">Iniciar sesión</a>
        </div>
    </div>
</div>
