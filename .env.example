# Copy this file to ".env" and fill in the values below before running docker-compose up.

# SQL Server "sa" password (8+ chars, must include uppercase, lowercase, a number, and a symbol).
DB_SA_PASSWORD=YourStrong!Passw0rd

# Secret key used to sign JWT access tokens.
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Google Gemini API key.
GEMINI_API_KEY=your-gemini-api-key

# Resend API key for transactional emails.
RESEND_API_KEY=your-resend-api-key

# Email address that receives redirected transactional emails in development.
RESEND_DEV_REDIRECT_EMAIL=you@example.com
