# Copia este archivo a ".env" (ya está en .gitignore, nunca lo subas con valores reales)
# y completa los valores antes de correr "docker-compose up".

# Si SQL Server corre en tu máquina host (fuera del contenedor), usa host.docker.internal
# en vez de localhost para que el contenedor de la API pueda alcanzarlo.
CONNECTION_STRING=Server=host.docker.internal,1433;Database=NutriMindDb;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=True

JWT_SECRET_KEY=replace-with-a-long-random-secret

GEMINI_API_KEY=your-gemini-api-key

RESEND_API_KEY=your-resend-api-key
RESEND_DEV_REDIRECT_EMAIL=you@example.com
