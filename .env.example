# Copia este archivo a ".env" (ya está en .gitignore, nunca lo subas con valores reales)
# y completa los valores antes de correr "docker-compose up".

# Contraseña del usuario "sa" del contenedor de SQL Server que levanta docker-compose.yml.
# Se usa tanto para inicializar ese contenedor como para la cadena de conexión de la API
# (docker-compose.yml la arma sola apuntando al servicio "db") — un solo valor, sin riesgo
# de que se desincronicen. SQL Server exige que sea "fuerte": mínimo 8 caracteres e incluir
# mayúsculas, minúsculas, números y un símbolo.
DB_SA_PASSWORD=YourStrong!Passw0rd

JWT_SECRET_KEY=replace-with-a-long-random-secret

GEMINI_API_KEY=your-gemini-api-key

RESEND_API_KEY=your-resend-api-key
RESEND_DEV_REDIRECT_EMAIL=you@example.com
